# 固定制品；下载、校验和 Compose 共用这一份配置。
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:ea610f2c82d033b6765b24fa7c0ab15c267d564f883de7c494f1e3073d496374
MODEL_REPOSITORY=unsloth/Qwen3.8-27B-GGUF
MODEL_REVISION=27af057ecb382ddfea5d12837360a8980560e3ed
MODEL_FILE=Qwen3.8-27B-UD-IQ3_XXS.gguf
MODEL_SIZE_BYTES=10934860704
MODEL_SHA256=c0b7c3038681ed2e3040456c1dd45f9858b6c2290bed172c70388a94874f3eee
SERVED_MODEL_ID=qwen3.8-27b-ud-iq3-xxs

# 网络。保持回环地址即可仅供本机访问；非回环监听必须同时设置 API Key。
BIND_ADDRESS=127.0.0.1
PUBLISH_PORT=18080
LLAMA_API_KEY=

# llama.cpp 运行参数。默认值针对 RTX 5070 Ti 16GB 的单并发 128K 文本服务。
CTX_SIZE=131072
N_PREDICT=4096
PARALLEL=1
GPU_LAYERS=all
CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0
BATCH_SIZE=512
UBATCH_SIZE=128
THREADS=8
THREADS_BATCH=16

# start.sh 等待容器健康的最长秒数。
START_TIMEOUT_SECONDS=600
